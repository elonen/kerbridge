# debian/check-manifests holds this ExecStart= and the Compose `sync` service's
# `entrypoint:` to the same string.
[Unit]
Description=KerBridge directory synchronisation daemon
Documentation=man:kerbridge-sync(8)
Wants=samba-ad-dc.service
After=samba-ad-dc.service network-online.target

# See the issuer's unit for this pair: a missing config set is a designed state,
# and anything a condition cannot see latches into `failed` after ~25 s.
ConditionPathExists=/etc/kerbridge/main.toml
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStartPre=/usr/bin/kbconfig --config /etc/kerbridge check
ExecStart=/usr/sbin/kerbridge-sync
Restart=on-failure
RestartSec=5s
User=_kerbridge-sync

# _kerbridge is this account's *primary* group: the postinst creates it with
# `adduser --ingroup`, so there is no per-user group and no SupplementaryGroups=.
Group=_kerbridge
StateDirectory=kerbridge/sync
StateDirectoryMode=0750
LogsDirectory=kerbridge/sync
LogsDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
