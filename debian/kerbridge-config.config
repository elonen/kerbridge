#!/bin/sh
# The three questions, asked before anything is unpacked.
#
# Policy §3.9.1: this script may run before unpack and before any dependency is
# satisfied, and must not touch the filesystem beyond reading. So it validates
# shape only -- is the realm a dotted name, does the URL say ldaps:// -- and
# leaves everything that needs the parser to `kbconfig check`, which the
# postinst runs after writing and which every daemon runs again at ExecStartPre.
#
# NOTHING SECRET PASSES THROUGH HERE, and that is structural rather than
# careful: every secret in the config set is a *path*, never a value, and the
# three answers below are a realm, a URL and the name of an adapter. It matters
# because /var/cache/debconf/config.dat is 0644 and config.dat-old is a
# world-readable copy of the previous state -- anything that transits debconf is
# exposed twice unless it is a Type: password, which writes it to a different
# file on disk instead.
#
# WHAT AN UNATTENDED INSTALL DOES. Under DEBIAN_FRONTEND=noninteractive every
# db_input returns 30, whatever its priority: Debconf::ConfModule runs the
# interactivity test after the priority and seen tests and overrides both. The
# value is then auto-set at db_go to the template's Default:, and a template
# with no Default: leaves db_get returning empty. That is the whole of the
# guard -- `realm` deliberately carries no Default:, so an unattended install
# with no preseed produces no configuration set at all rather than one naming a
# realm nobody chose.
#
# `provider` does carry a Default:, so an unattended install with a preseeded
# realm and no provider answer takes `entra` and writes a source file whose
# identifiers are still lines to complete. That set fails `kbconfig check` and
# starts no daemon, which is the intended outcome: nothing is frozen until sync
# first runs, so the source is still the operator's to change or remove.
set -e
. /usr/share/debconf/confmodule

# `dpkg-reconfigure` forces the priority to low and sets a reshow flag, so all
# three questions come back. Without this they would come back holding the
# answers given at install time, which for a set that has since been edited is
# a lie -- the debconf-devel(7) config-file idiom is to db_set each question
# from the file first, so the operator is shown the file's truth.
#
# Guarded on the binary because of Policy §3.9.1 above: on first install
# /usr/bin/kbconfig is genuinely not there yet, and this script has to work
# with Essential packages alone.
from_set() { # question dotted-path
    value=$(/usr/bin/kbconfig --config /etc/kerbridge get "$2" 2>/dev/null) || return 0
    [ -n "$value" ] || return 0
    db_set "$1" "$value"
}
# The provider question has no read-back on purpose: `kbconfig get` answers out
# of a *loaded* set, and the set this most wants to show an operator is one that
# does not load yet -- a fresh install whose identifiers are still lines to
# complete.
if [ -x /usr/bin/kbconfig ] && [ -f /etc/kerbridge/main.toml ]; then
    from_set kerbridge-config/realm realm.realm
    from_set kerbridge-config/ldap_url realm.ldap_url
fi

# Ask, and keep asking until the answer has the right shape.
#
# THE LOOP MUST BREAK ON 30, UNCONDITIONALLY. db_input returns 30 for every
# question in every non-interactive frontend, so a loop that only exits on a
# valid answer spins forever in each unattended install, unattended upgrade and
# image build. debconf-devel(7) documents this trap under "Preventing infinite
# loops"; the `|| break` below is it.
ask() { # question [validator [error-template]]
    while :; do
        code=0
        db_input high "$1" || code=$?
        [ "$code" -ne 30 ] || break
        db_go || break
        [ -n "$2" ] || break
        db_get "$1"
        # An empty answer is "no opinion" and is a legal outcome for every
        # question here: it is what arms the write-nothing rule for the realm.
        # Only a non-empty answer of the wrong shape is worth re-asking for.
        [ -n "$RET" ] || break
        if "$2" "$RET"; then
            break
        fi
        # A Type: error template is shown above the priority threshold and even
        # when already seen, so it needs no priority of its own; clearing the
        # question's own seen flag is what makes the next db_input ask again.
        db_input critical "$3" || true
        db_go || break
        db_fset "$1" seen false
    done
}

# A dotted domain name: at least two labels, letters, digits and hyphens only.
# Case is not checked here -- kbconfig refuses a lower-case realm by name, with
# a better sentence than this script could give, and refusing it in two places
# means two places to keep in step.
is_realm() {
    case "$1" in
        *[!A-Za-z0-9.-]*) return 1 ;;
        .* | *. | *..*) return 1 ;;
        *.*) return 0 ;;
        *) return 1 ;;
    esac
}

is_ldaps() {
    case "$1" in ldaps://?*) return 0 ;; *) return 1 ;; esac
}

ask kerbridge-config/realm is_realm kerbridge-config/realm_invalid

# The proposed LDAPS URL is computed rather than written into the template,
# because it is derived from the answer above and a template Default: cannot
# be. Set only when the question is still empty, so a preseeded value is never
# clobbered -- and only when there is a realm to derive from, since
# "ldaps://kerbridge.:636" is worse than no proposal at all.
db_get kerbridge-config/realm
realm=$RET
db_get kerbridge-config/ldap_url
if [ -z "$RET" ] && [ -n "$realm" ]; then
    lower=$(printf '%s' "$realm" | tr '[:upper:]' '[:lower:]')
    db_set kerbridge-config/ldap_url "ldaps://kerbridge.$lower:636"
fi
ask kerbridge-config/ldap_url is_ldaps kerbridge-config/ldap_url_invalid

# Which adapter, or none. `none` is a legal answer and a legal deployment: a
# realm-only set -- main.sources = [] -- is exactly the administrator's host
# that runs kbmanage and no daemon.
#
# Nothing about the tenant is asked. Those identifiers are lines to complete in
# the source file, listed all at once by the `kbconfig check` the postinst runs
# at the end. Asking for them here would let a set nobody completed pass that
# check with the documented examples in it.
ask kerbridge-config/provider

# All three are `high`, and none is lower, because debconf's stock threshold is
# high -- Debconf::Config::priority hardcodes it as the fallback and
# debconf/priority ships Default: high. A `medium` question here would be a
# question nobody is ever shown.
exit 0
