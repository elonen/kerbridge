# Caddy in front of kerbridge-broker, on the broker's own host.
#
# The broker serves plain HTTP and refuses any listen address that is not on
# the loopback interface -- that is enforced in the program, so TLS terminates
# here, on this machine, and cannot terminate on another one.
#
# This is the Docker Compose deployment's own site body with the upstream written out
# rather than interpolated. Both come from deploy/caddy/, which is what the
# stack test exercises end to end.
#
# Copy to /etc/caddy/Caddyfile, or import it from one, and replace the address.
#
# As written, Caddy obtains and renews the certificate itself over ACME, which
# needs port 80 reachable from the internet. To supply the certificate yourself
# instead -- from your own CA, from a wildcard, or from a renewal flow that runs
# somewhere else -- see the block at the end of this file.

kerbridge.example.site {
	# Only the documented routes are proxied. Anything else never reaches the
	# broker at all, so this list has to move whenever the broker's router
	# does: a route it omits is a 404 at the edge that no test reaching the
	# broker directly can see. The first segment is the source name, from
	# main.toml's `sources`. `/config` without a segment is the address an SRV
	# record can express; the broker answers it only where one source makes
	# the answer unambiguous.
	@api path_regexp ^(/config|/[A-Za-z0-9._-]+/(config|ticket|nonce|devices)(/[^/]+)?)$
	handle @api {
		# A ticket response carries a credential cache; a request carries a
		# bearer token. Neither belongs in a log: Caddy logs no body by
		# default, and a `log` directive added here must not start.
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8080
	}

	# One static page, for the person who types this address into a browser --
	# an address they saw in a dialog, or in an agent that is not working. A
	# 404 there reads as "the service is broken". kerbridge-broker ships the
	# page; it names no realm, no version and no component, and Caddy serves it
	# without reaching the broker or any identity.
	@root path /
	handle @root {
		root * /usr/share/kerbridge/site
		file_server
	}

	# Everything else, including anything deeper than the routes above.
	handle {
		respond 404
	}
}

# Connection deadlines. Caddy sets none of these by default -- a connection may
# take as long as it likes to send a request, and an idle one is kept for five
# minutes. That is reasonable for a public web server and poor here: this is
# the deployment's only internet-facing listener, every connection costs a TLS
# handshake, and the sole legitimate client makes a couple of requests a day.
#
# Put this in the global options block at the top of your Caddyfile.
#
#	{
#		servers {
#			timeouts {
#				read_header 10s
#				read_body 30s
#				idle 60s
#			}
#		}
#	}
#
# `write` is deliberately absent: the response comes from the broker, and any
# write deadline short enough to matter against an attacker would cut off a
# legitimate slow issuance instead.

# A certificate you supply yourself, instead of ACME.
#
# Caddy's automatic HTTPS is the default above and needs inbound port 80 for the
# challenge. Where that port is closed, or the certificate comes from your own
# CA or a wildcard, name the files instead. Two changes, both required: the site
# address gains an explicit scheme and port, and `auto_https off` stops Caddy
# from trying to obtain one anyway.
#
# The Docker Compose deployment calls this the `external` TLS strategy and makes
# it the default there, because it keeps issuance credentials -- and, under
# DNS-01, the authority to alter DNS -- off this host entirely.
#
#	{
#		auto_https off
#	}
#
#	https://kerbridge.example.site:443 {
#		tls /etc/caddy/tls/broker.crt /etc/caddy/tls/broker.key
#		... the same handle blocks as above ...
#	}
#
# Caddy reads the files at startup and does not watch them, so a renewal needs a
# `caddy reload` -- not a restart, which drops connections. The key must be
# readable by the user Caddy runs as, and by nobody else.
