#!/bin/sh
# What purge removes, minus the parts that belong to the packages that made
# them: the krb5 drop-in and its include line are kerbridge-issuerd's, and each
# daemon's own state and log directory is that daemon's package's.
#
# THE RULE THAT MATTERS MOST IS WHAT IS NOT HERE. Nothing removes the contents
# of /etc/kerbridge.secrets, nothing touches /var/lib/samba or /etc/samba, and
# nothing removes an audit log. Purging all six packages leaves a working
# domain controller, its domain SID, and every filesystem ACL riding on that
# SID. The unix accounts stay too: postrm may rely only on Essential
# packages and `deluser` is not one -- it is measurably absent on trixie and
# noble -- and a uid that a later `adduser` reallocates would inherit whatever
# files elsewhere still carry it.
#
# `rmdir` if empty, never `rm -r`, is what makes both true at once. piuparts
# never starts a daemon, so it always finds these directories empty and passes
# with no exception file, while a live deployment keeps its records.
set -e

case "$1" in
    purge)
        rm -f /etc/kerbridge/*.toml
        # What `kbconfig upgrade` keeps of the file it replaced, and the only
        # surviving copy of any comment the operator wrote themselves. Kept
        # while the package is installed, removed on purge -- leaving them
        # behind is what piuparts calls a leftover file.
        rm -f /etc/kerbridge/*.toml.bak
        # The realm's own CA, published here by `kbsetup realm`. Not a secret:
        # it is the anchor an LDAPS client checks the domain controller
        # against, and it is regenerated by provisioning.
        rm -f /etc/kerbridge/certs/realm-ca.pem

        # Deepest first, and every one conditional on being empty.
        for dir in \
            /etc/kerbridge/certs \
            /etc/kerbridge \
            /etc/kerbridge.secrets/generated/idp/* \
            /etc/kerbridge.secrets/generated/idp \
            /etc/kerbridge.secrets/generated \
            /etc/kerbridge.secrets/idp/* \
            /etc/kerbridge.secrets/idp \
            /etc/kerbridge.secrets \
            /var/lib/kerbridge \
            /var/log/kerbridge
        do
            [ -d "$dir" ] && rmdir "$dir" 2>/dev/null || true
        done
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdebconf puts `db_purge` here, which is what stops
# postrm-does-not-purge-debconf.
#DEBHELPER#

exit 0
