#!/usr/bin/make -f
#
# The six binary packages, from binaries somebody else built.
#
# WHY NOTHING HERE RUNS CARGO. The five programs are statically linked musl
# artifacts, and that is what makes one amd64 deb install unchanged on every
# supported release. The toolchain that produces them is the digest-pinned
# rust:alpine builder the images already use; a Debian builder cannot make the
# same bytes. So the build and the packaging are two stages, and this file is
# only the second one: it stages a tree somebody handed it and lets debhelper
# cut six debs out of it.
#
# THE HANDOVER. Everything a package ships that is not in this source tree is
# expected under debian/prebuilt/, laid out at the paths it installs to:
#
#   debian/prebuilt/usr/sbin/{issuerd,kbsetup,kerbridge-broker,kerbridge-sync}
#   debian/prebuilt/usr/bin/{kbconfig,kbmanage}
#   debian/prebuilt/usr/share/man/man1/kbconfig.1
#   debian/prebuilt/usr/share/man/man1/kbmanage*.1
#   debian/prebuilt/usr/share/man/man8/kbsetup*.8
#   debian/prebuilt/THIRD-PARTY-NOTICES
#
# `debian/stage-prebuilt` fills that directory from a cargo target directory
# and is what a person runs by hand. `debian/Dockerfile` -- `make debian-docker`
# -- fills the same directory from the pinned toolchain, because the contract is
# a path rather than a program.
#
# The man pages are in the handover rather than in this tree because three of
# the six are generated by clap_mangen at build time and have no committed copy
# -- that is what makes them impossible to leave stale. The three
# hand-written ones do live here, under debian/man/, and are staged below.
#
# debian/changelog is not in git either: it is generated from CHANGELOG.md and
# `git describe` by `debian/make-changelog`, which is the release process in
# one file. dpkg-buildpackage needs it present before it starts, so it
# is generated before the build rather than by it.

# Where the handover lands. Overridable so a caller with a staging tree of its
# own does not have to copy it into this one first.
PREBUILT ?= debian/prebuilt

%:
	dh $@

# Nothing to configure, build, test or clean: see the header. Each is
# overridden to nothing rather than left out, because dh's default for a tree
# holding a Cargo.toml is to look for a build system and guess.
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

# The translation template, refreshed from debian/kerbridge-config.templates
# every time. `dpkg-buildpackage` runs `debian/rules clean` before it builds
# anything, so this is what makes a stale templates.pot impossible rather than
# merely discouraged -- the same rule the generated man pages follow. The
# committed copy is what a translator starts from; this is what stops it
# drifting from the questions actually asked.
override_dh_clean:
	# The address is stated rather than left to default. `debconf-updatepo`
	# builds one from the Source: field -- kerbridge@packages.debian.org --
	# which is a real convention for a package in Debian and a mailbox nobody
	# reads for one that is not. It costs the Project-Id-Version header, which
	# debconf-updatepo only fills in when it derives the address itself; that
	# field is a translator's to set and nothing reads it here.
	debconf-updatepo --msgid-bugs-address=elonen@iki.fi
	dh_clean

# One staging tree, debian/tmp, and every *.install file names a path in it.
# The alternative -- some paths from debian/tmp and some relative to the source
# directory -- works, and is the way a reader stops being able to tell where a
# shipped file came from.
override_dh_auto_install:
	@test -d "$(PREBUILT)/usr" || { \
	  echo "debian/rules: no built binaries under $(PREBUILT)/." >&2; \
	  echo "    This packaging installs artifacts, it does not compile them --" >&2; \
	  echo "    see the header of debian/rules. Run debian/stage-prebuilt, or" >&2; \
	  echo "    point PREBUILT= at a tree that already has them." >&2; \
	  exit 1; }
	mkdir -p debian/tmp
	cp -a "$(PREBUILT)/usr" debian/tmp/
	# Staged rather than named from $(PREBUILT) in the five *.docs files: a
	# *.docs file cannot read a make variable, and PREBUILT is overridable.
	install -D -m 0644 "$(PREBUILT)/THIRD-PARTY-NOTICES" \
	    debian/tmp/THIRD-PARTY-NOTICES
	# kerbridge-config's tier-2 helper, at the path that package installs it
	# to. Both deployments run these same bytes: this postinst calls it
	# directly, and Compose calls it in a throwaway root container.
	install -D -m 0755 crates/kerbridge-config/libexec/prepare-state \
	    debian/tmp/usr/libexec/kerbridge/prepare-state
	# The three hand-written pages. They list no options at all, on purpose,
	# and `make test` holds them to it -- a page that names a flag is a page
	# that goes stale, and these three daemons parse their arguments by hand
	# rather than with clap, so nothing can generate them.
	install -D -m 0644 debian/man/issuerd.8 debian/tmp/usr/share/man/man8/issuerd.8
	install -D -m 0644 debian/man/kerbridge-broker.8 \
	    debian/tmp/usr/share/man/man8/kerbridge-broker.8
	install -D -m 0644 debian/man/kerbridge-sync.8 \
	    debian/tmp/usr/share/man/man8/kerbridge-sync.8

# dh_install drops whatever no *.install claims, and says nothing. The drift
# this catches: kerbridge-manage/build.rs renders one page per verb by walking
# the command definition, while stage-prebuilt and kerbridge-manage.install
# name the eight by hand -- so a new verb ships no page until both lists grow.
override_dh_missing:
	dh_missing --fail-missing

# Keep dh_strip. Cargo's `strip = "symbols"` does not leave nothing to do:
# without this step lintian reports an unneeded .comment section.
# --no-automatic-dbgsym rather than DEB_BUILD_OPTIONS=noautodbgsym, which is
# the same thing decided here instead of in the caller's environment: the
# release profile carries no debug info, so the -dbgsym package dh would
# otherwise generate is empty and draws debug-file-with-no-debug-symbols.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# Noise, once per binary across five packages: dwz prints ".debug_info section
# not present" and exits 0. Two lines here buy a clean build log.
override_dh_dwz:
