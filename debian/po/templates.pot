#. Type: string
#. Description
#: ../kerbridge-config.templates:2001
msgid "Kerberos realm for this deployment:"
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:2001
msgid ""
" KerBridge serves one Kerberos realm.\n"
" Give it in upper case, for example EXAMPLE.SITE.\n"
" KerBridge derives other values from it: the domain root,\n"
" the DNS domain, the NetBIOS name, the short name of the\n"
" domain controller, and two organizational units."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:2001
msgid ""
" You cannot correct the realm later.\n"
" It goes into the Samba database,\n"
" and the permissions of every file carry an identifier from it.\n"
" This is binary data in many places, and no edit can change it.\n"
" To use a different realm, provision the domain again."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:2001
msgid ""
" KerBridge writes the initial config files\n"
" on the first installation only.\n"
" If you leave this empty, it writes nothing."
msgstr ""

#. Type: error
#. Description
#: ../kerbridge-config.templates:3001
msgid "Invalid Kerberos realm"
msgstr ""

#. Type: error
#. Description
#: ../kerbridge-config.templates:3001
msgid ""
" A realm is a domain name with dots and no spaces,\n"
" for example EXAMPLE.SITE.\n"
" Your value is not a realm name."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:4001
msgid "LDAPS URL of the domain controller:"
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:4001
msgid ""
" KerBridge binds to this address.\n"
" It accepts ldaps:// only, because plain LDAP and StartTLS\n"
" send the bind password and each password write in clear text."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:4001
msgid ""
" The proposed address uses a domain controller with the name\n"
" \"kerbridge\" in the realm above.\n"
" Change the host name if yours is different."
msgstr ""

#. Type: error
#. Description
#: ../kerbridge-config.templates:5001
msgid "Invalid LDAPS URL"
msgstr ""

#. Type: error
#. Description
#: ../kerbridge-config.templates:5001
msgid ""
" The address must start with ldaps://.\n"
" KerBridge refuses plain ldap:// and StartTLS.\n"
" An address in that form fails later."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:6001
msgid "Cloud IdP tenant id:"
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:6001
msgid ""
" The Microsoft Entra ID tenant whose users this deployment admits.\n"
" Give the tenant id as a UUID."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:6001
msgid ""
" Leave this empty only for a host that does no synchronization\n"
" and serves no sign-ins, for example an administrator machine\n"
" with kerbridge-manage.\n"
" KerBridge then writes the config files\n"
" with no identity provider in them."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:6001
msgid " This is not a secret."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:7001
msgid "UUID of the broker's Entra app, usually named \"KerBridge broker API\":"
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:8001
msgid ""
"UUID of the client's Entra app, usually named \"KerBridge public client\":"
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:9001
msgid "UUID of the sync Entra app, usually named \"KerBridge sync\":"
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:10001
msgid "Name of the cloud group whose members are admitted:"
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:10001
msgid ""
" Membership of this group admits an identity.\n"
" KerBridge does not mirror the other users into the directory,\n"
" and refuses each sign-in for them.\n"
" Nothing works until a group with this name exists in the Entra tenant."
msgstr ""

#. Type: string
#. Description
#: ../kerbridge-config.templates:10001
msgid ""
" Any group is possible; this name is only a suggestion.\n"
" When the realm is live, replace the name with the object id\n"
" of the group in /etc/kerbridge/idp_entra.toml,\n"
" so that a rename cannot point it elsewhere."
msgstr ""
