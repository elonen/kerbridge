# debian/check-manifests holds this ExecStart= and the Compose `issuer`
# service's `entrypoint:` to the same string.
[Unit]
Description=KerBridge issuer daemon
Documentation=man:issuerd(8)

# Wants=, never Requires=: stopping the domain controller for maintenance must
# not stop the issuer. samba-ad-dc.service, never samba.service -- Debian gates
# each Samba unit with ExecCondition=/usr/share/samba/is-configured.
Wants=samba-ad-dc.service
After=samba-ad-dc.service

# Installed and not yet configured is a designed state. Without this line it is
# a crash loop: ExecStartPre= fails with no config set, and RestartSec=5s spaces
# the retries wider than the stock limiter's 5 in 10 s, so it never trips.
ConditionPathExists=/etc/kerbridge/main.toml

# For the failures a condition cannot see: `failed` after ~25 s. Both halves are
# needed and both belong in [Unit] -- the interval alone leaves the stock burst
# of 5. `kbsetup directory` and `kbsetup secrets` start what has latched.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec

# Never --online: a boot with no network must not wedge the unit.
ExecStartPre=/usr/bin/kbconfig --config /etc/kerbridge check
ExecStartPre=/usr/sbin/kbsetup verify
ExecStart=/usr/sbin/issuerd
Restart=on-failure
RestartSec=5s

# /run is tmpfs, which is what keeps tmp_dir's key material off a disk. issuerd
# chowns and chmods both directories itself, so one mode for the pair is not the
# clash it looks like.
RuntimeDirectory=kerbridge issuer
RuntimeDirectoryMode=0700

# systemd owns these; `prepare-state` owns their parents. Two mechanisms
# creating one directory is how they come to disagree about its mode.
StateDirectory=kerbridge/issuerd
StateDirectoryMode=0750
LogsDirectory=kerbridge/issuerd
LogsDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

# Required: under ProtectSystem=strict alone /tmp is read-only -- measured --
# and issuerd spawns samba-tool, which is Python. Never `disconnected`: that
# value is systemd 257 and later, and noble (255) parses it to false.
PrivateTmp=yes

# ldbmodify writes sam.ldb. /etc/samba stays absent -- smb.conf is kbsetup's.
ReadWritePaths=/var/lib/samba

# `kbsetup verify` republishes the realm CA here. Nothing widens this to
# /etc/kerbridge itself, which this daemon only reads.
ReadWritePaths=-/etc/kerbridge/certs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# No User=: issuerd holds KDC authority and reads sam.ldb directly, so it runs
# as root. No CapabilityBoundingSet= either -- it buys little on such a daemon.

[Install]
WantedBy=multi-user.target
