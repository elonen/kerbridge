#!/bin/sh
# The one edit this package makes outside its own tree: an `includedir` line in
# /etc/krb5.conf, so that the drop-in `kbsetup realm` writes is read at all.
#
# WHY A DROP-IN AND NOT THE FILE. Owning /etc/krb5.conf outright was the
# earlier plan, and measurement overturned it. Measured on trixie and noble,
# with the resolver pinned to a dead nameserver so that no DNS
# wildcard could answer an SRV lookup; the discriminator is MIT's own
# KRB5_TRACE output rather than inspection. Re-check any line below with
# `KRB5_TRACE=/dev/stderr kinit -k <principal>` on the release in question.
# The findings that shape what is below:
#
#   * No release ships an `includedir` line, and no release ships or owns
#     /etc/krb5.conf.d/. Both have to be made here.
#   * A drop-in alone does nothing -- MIT's own KRB5_TRACE shows the SRV lookup
#     still going out. With the include line added, the same test resolves the
#     configured KDC by name.
#   * With no /etc/krb5.conf at all, a drop-in is never read: there is no
#     implicit include.
#   * A DANGLING `includedir` IS FATAL, not ignored: every krb5 binary on the
#     host, not only ours, fails with "Included profile directory could not be
#     read". So the directory is created *before* the line that names it, and
#     the purge order in postrm is the reverse. An empty but existing directory
#     is fine.
#   * A hand-added include line survives `dpkg-reconfigure krb5-config`
#     byte-for-byte.
#   * THE LINE GOES FIRST, NOT LAST. MIT's profile is first-wins for a scalar,
#     and an included file is spliced in where the include line sits. So a line
#     appended under krb5-config's own [libdefaults] loses: `default_realm`
#     resolves to what krb5-config wrote, which is `ATHENA.MIT.EDU` on an
#     install that answered no questions. krb5-user Recommends krb5-config, so
#     a plain `apt install kerbridge` is exactly that install. Measured on
#     trixie with `kinit -V`: appended gives `nobody@ATHENA.MIT.EDU`, prepended
#     gives the realm the drop-in names.
#
# The line is content-free -- no realm, no host, nothing debconf answers. The
# substantive configuration is /etc/krb5.conf.d/kerbridge.conf, generated from
# the config set by `kbsetup realm` and removed cleanly on purge.
set -e

KRB5_CONF=/etc/krb5.conf
KRB5_CONF_D=/etc/krb5.conf.d
MARKER='# Added by kerbridge-issuerd. Removed again when this package is purged.'
INCLUDE="includedir $KRB5_CONF_D/"

case "$1" in
    configure)
        # This package creates no unix account: issuerd runs as root because it
        # holds KDC authority and reads sam.ldb directly. The _kerbridge
        # group it chowns the issuer socket to comes from kerbridge-config,
        # which dpkg configures first.

        # The directory first, always -- see the header.
        if [ ! -d "$KRB5_CONF_D" ]; then
            mkdir -p "$KRB5_CONF_D"
            chmod 0755 "$KRB5_CONF_D"
        fi

        if [ ! -e "$KRB5_CONF" ]; then
            # krb5-user Recommends krb5-config on both targets, so
            # --no-install-recommends really does leave no /etc/krb5.conf.
            # The content is the include line and nothing else: everything with
            # an opinion in it belongs in the drop-in.
            {
                printf '%s\n' "$MARKER"
                printf '%s\n' "$INCLUDE"
            } > "$KRB5_CONF"
            chmod 0644 "$KRB5_CONF"
        elif ! head -n 2 "$KRB5_CONF" | grep -qxF "$INCLUDE"; then
            # Not merely present -- present at the top, which is where it has
            # to be to win. `head -n 2` is exactly what this branch writes, so
            # a host already in that state is left byte-for-byte alone. A copy
            # lower down is one an older version appended; it moves up here.
            tmp=$(mktemp "$KRB5_CONF.XXXXXX")
            {
                printf '%s\n' "$MARKER"
                printf '%s\n' "$INCLUDE"
                # No blank line after the pair. Purge removes exactly these
                # two lines, so a separator it does not account for stays
                # behind, at the top of a file this package does not own.
                grep -vxF -e "$MARKER" -e "$INCLUDE" "$KRB5_CONF" || true
            } > "$tmp"
            chmod 0644 "$tmp"
            mv "$tmp" "$KRB5_CONF"
        fi

        # What is still outstanding, printed where the operator is standing.
        # Installing the packages finishes nothing: the realm, the directory
        # and the cloud IdP's own client secret are all still to come.
        #
        # The verb rather than a checklist written out here: a maintainer
        # script holding a second account of the procedure is the account that
        # goes stale, and `status` reads the state on disk, so it is right on a
        # re-install and on an upgrade too.
        #
        # Never fatal: `status` exits 2 while any step remains, which is the
        # normal outcome here, and a postinst that failed over it would wedge
        # apt for every other package. `-e` guards a host with no config set.
        if [ -e /etc/kerbridge/main.toml ]; then
            /usr/sbin/kbsetup status || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
