# debian/check-manifests holds this ExecStart= and the Compose `broker`
# service's `entrypoint:` to the same string.
[Unit]
Description=KerBridge broker daemon
Documentation=man:kerbridge-broker(8)
Wants=kerbridge-issuerd.service
After=kerbridge-issuerd.service network-online.target

# See the issuer's unit for this pair: a missing config set is a designed state,
# and anything a condition cannot see latches into `failed` after ~25 s.
ConditionPathExists=/etc/kerbridge/main.toml
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStartPre=/usr/bin/kbconfig --config /etc/kerbridge check
ExecStart=/usr/sbin/kerbridge-broker
Restart=on-failure
RestartSec=5s
User=_kerbridge-broker

# _kerbridge is this account's *primary* group: the postinst creates it with
# `adduser --ingroup`, so there is no per-user group and no SupplementaryGroups=.
Group=_kerbridge
StateDirectory=kerbridge/broker
StateDirectoryMode=0750
LogsDirectory=kerbridge/broker
LogsDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Empty: `listen` is loopback on a high port -- the code refuses anything else
# -- so not even CAP_NET_BIND_SERVICE is wanted. A privileged port would then
# fail to bind.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
