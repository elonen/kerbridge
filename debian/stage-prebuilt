#!/bin/sh
# Fill debian/prebuilt/ from a cargo target directory, so that
# `dpkg-buildpackage` has something to package.
#
# This is the by-hand half of the handover debian/rules describes. The other
# half is debian/Dockerfile -- `make debian-docker` -- which fills the same
# directory, because the contract between the build and the packaging is a path
# rather than a program.
#
# WHAT IT DOES NOT DO. It does not build. The six programs are static musl
# artifacts built by the digest-pinned rust:alpine toolchain the images use,
# and a release built any other way is not the deb that ships. Point TARGET at
# the directory that toolchain wrote, or -- for a local test of the packaging
# rather than of the binaries -- at an ordinary `cargo build --release` tree
# and know that that is what you have.
#
# usage: debian/stage-prebuilt [<target-dir>]
#        TARGET=<dir> debian/stage-prebuilt
set -eu

cd "$(dirname "$0")/.."

TARGET=${1:-${TARGET:-${CARGO_TARGET_DIR:-target}/release}}
OUT=debian/prebuilt

[ -d "$TARGET" ] || { echo "stage-prebuilt: no such directory: $TARGET" >&2; exit 1; }

rm -rf "$OUT"
mkdir -p "$OUT/usr/sbin" "$OUT/usr/bin" \
         "$OUT/usr/share/man/man1" "$OUT/usr/share/man/man8"

# /usr/sbin if root is the only user, /usr/bin if an operator runs it -- FHS
# 3.0 §4.10's own test, and not a guess about privilege. It is not
# cosmetic: /usr/sbin is on no non-root PATH on any Debian release, so kbconfig
# and kbmanage in /usr/sbin would be programs an operator could not invoke by
# name.
for b in issuerd kbsetup kerbridge-broker kerbridge-sync; do
    install -m 0755 "$TARGET/$b" "$OUT/usr/sbin/$b"
done
for b in kbconfig kbmanage; do
    install -m 0755 "$TARGET/$b" "$OUT/usr/bin/$b"
done

# The generated pages. They land in each crate's OUT_DIR, whose name carries a
# hash cargo does not promise, so they are found rather than constructed --
# newest first, in case an older build's directory is still there.
#
# `ls -t` rather than `find -printf`: `-printf` is a GNU extension, and the
# stage that runs this is the alpine builder, whose find is busybox.
page() { # glob section
    found=$(find "$TARGET/build" -name "$1" -exec ls -t {} + 2>/dev/null | head -n 1)
    [ -n "$found" ] || {
        echo "stage-prebuilt: no $1 under $TARGET/build." >&2
        echo "    It is generated by a build script; run 'cargo build --release'" >&2
        echo "    for the crate that owns it and try again." >&2
        exit 1
    }
    install -m 0644 "$found" "$OUT/usr/share/man/man$2/$(basename "$found")"
}
page kbconfig.1 1
for verb in '' -group -cloud -device -doctor -endpoint -config; do
    page "kbmanage$verb.1" 1
done
for verb in '' -realm -directory -verify; do
    page "kbsetup$verb.8" 8
done

# The notices every static binary has to carry. MIT, BSD and Apache-2.0 all
# require their notice to travel with a binary copy, and a static musl binary
# is a binary copy -- so this is a licensing obligation rather than a packaging
# one, which is why debian/copyright points at it rather than reproducing it.
if [ -f "$TARGET/THIRD-PARTY-NOTICES" ]; then
    install -m 0644 "$TARGET/THIRD-PARTY-NOTICES" "$OUT/THIRD-PARTY-NOTICES"
elif command -v cargo-about >/dev/null 2>&1; then
    cargo about generate --config debian/about.toml debian/about.hbs \
        > "$OUT/THIRD-PARTY-NOTICES"
else
    echo "stage-prebuilt: cargo-about is not installed and $TARGET holds no" >&2
    echo "    THIRD-PARTY-NOTICES, so a placeholder is being staged. The debs" >&2
    echo "    built from it are NOT distributable: every static binary has to" >&2
    echo "    carry the notices of the crates linked into it." >&2
    printf '%s\n' \
        "THIRD-PARTY-NOTICES placeholder." \
        "" \
        "This build staged no notices. Install cargo-about and run" \
        "debian/stage-prebuilt again, or put a generated file at" \
        "$TARGET/THIRD-PARTY-NOTICES." > "$OUT/THIRD-PARTY-NOTICES"
fi

echo "stage-prebuilt: $OUT is ready ($(find "$OUT" -type f | wc -l | tr -d ' ') files)"
