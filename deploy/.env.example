## deploy/.env -- Docker deployment variables, and only that.
##
## Two things read this file: `compose.yaml` interpolates it, and the
## scripts under deploy/scripts/ source it as shell. Both read deploy/bench.env
## before it -- tracked fixtures for the development bench -- and this file
## last, so anything set here wins.
##
## Quote any value containing a space.
##
## MOST SETTINGS ARE NOT HERE. The services themselves read configs/.
## Rename *.toml.example -> *.toml in configs/ and edit them.


# --- Looking for something that is not in this file? ------------------------
#
#   Cloud IdP/provider settings         configs/idp_<source>.toml, [provider_config]
#   Who may get a ticket                configs/idp_<source>.toml, admission_group_id
#   Base DN, OUs, source name           configs/realm.toml, configs/idp_<source>.toml
#   Login-name source, sync interval    configs/sync.toml
#   Ticket lifetime and renewal         configs/realm.toml
#   Device grants                       configs/main.toml, configs/idp_<source>.toml
#   Operator notification               configs/main.toml [notify], secrets/notify_url
#   Concurrency caps                    configs/broker.toml, configs/issuerd.toml
#
# You can use `dist/kbconfig check` to validate them.
# Secrets go in secrets/, not in config files.


# === 1. YOU MUST SET THESE ===================================================

# Realm identity -- SET ONCE, BEFORE THE FIRST `make up`.
#
# Not what the database is provisioned from: `kbsetup realm` reads that out of
# configs/realm.toml. These are what compose interpolates -- the container's
# hostname, the network aliases, the member's /etc/hosts -- and check-env.sh
# refuses a copy that disagrees with the config set, because each side reads
# correctly on its own and only the pair is wrong.
#
# AD_DNS_DOMAIN is AD_REALM lowercased, not a separate choice. AD_REALM must
# equal `realm` in configs/realm.toml, AD_NETBIOS_DOMAIN what that file resolves
# `netbios_domain` to, and AD_DC_HOSTNAME what it resolves `dc_hostname` to.

AD_REALM=EXAMPLE.SITE
AD_DNS_DOMAIN=example.site
AD_NETBIOS_DOMAIN=EXAMPLE

# The DC's short name, and the name your TLS certificate is issued for. The
# realm's LDAPS certificate covers ${AD_DC_HOSTNAME}.${AD_DNS_DOMAIN}, which is
# what `ldap_url` in configs/realm.toml must name.

BROKER_FQDN=kerbridge.example.site
AD_DC_HOSTNAME=kerbridge


# How the HTTPS endpoint gets a certificate. One of:
#   external  You supply secrets/tls/broker.crt + broker.key, and call
#             scripts/compose/reload-caddy.sh on renew.
#   acme-dns  Caddy auto-issues by TXT record, with ACME DNS-01. Needs the two
#             settings below.
#   acme      Caddy auto-issues over an inbound challenge -- TLS-ALPN-01 on :443,
#             or HTTP-01 if you also publish :80. Not recommended: BROKER_FQDN
#             must then be reachable from the Internet.

TLS_STRATEGY=acme-dns

# --- acme-dns only ---

# Your DNS provider's Caddy module, from https://github.com/caddy-dns/*.
# A change needs `docker compose build caddy`.

CADDY_DNS_MODULE=github.com/caddy-dns/route53

# Your module's own credentials go in secrets/acme-dns.env as KEY=value pairs,
# and are referenced here. The example is route53; read your module's docs.

ACME_DNS_PROVIDER=
#ACME_DNS_PROVIDER="route53 {
#    access_key_id {env.ROUTE53_ACCESS_KEY_ID}
#    secret_access_key {env.ROUTE53_ACCESS_KEY_SECRET}
#    region {env.ROUTE53_REGION}
#    wait_for_route53_sync true
#}"


# === 2. OPTIONAL - defaults usually work =====================================

# --- ACME, for TLS_STRATEGY=acme and acme-dns ---
# Use staging while debugging a challenge, so LE will not rate limit you.

ACME_CA=https://acme-v02.api.letsencrypt.org/directory
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Resolvers for the propagation check. Must be public, not an internal resolver.
ACME_DNS_RESOLVERS="1.1.1.1 9.9.9.9"

# --- What to listen on ---

# AD LDAPS (636). 0.0.0.0 if you need LDAP from outside, e.g. ADUC over RSAT;
# then firewall 636 and 445 to the hosts that need them.
LDAPS_BIND=127.0.0.1

# Domain members (LDAP 389, SMB 445). What a file server you join yourself
# reaches the DC on. Open by default: a DC no member can join is not useful.
MEMBER_BIND=0.0.0.0

# The KDC (88). Open by default and normally stays that way -- every client that
# authenticates needs it, which is the whole product. Narrow it only when this
# host has a management interface with no business answering Kerberos.
KDC_BIND=0.0.0.0


# === 3. RARELY TOUCHED =======================================================

# The DC's upstream resolver and Samba's dynamic RPC ports are NOT here. They are
# configs/realm.toml's `dns_forwarder` and `rpc_port_range`, under [provision],
# because the realm is provisioned from the config set rather than from this file.
# An older .env that still sets AD_DNS_FORWARDER or AD_RPC_PORT_RANGE is caught by
# check-env.sh rather than left to lose the setting quietly.

# Caddy's log level. DEBUG when a certificate is not arriving, then back -- at
# INFO every DNS-01 failure prints the same unhelpful line. Not a build arg, so
# `docker compose up -d caddy` is the whole round trip. Never leave it empty: an
# empty value beats the Caddyfile default and Caddy exits on a parse error.
# What DEBUG shows you: deploy/README.md @ Certificates.
CADDY_LOG_LEVEL=INFO
#CADDY_LOG_LEVEL=DEBUG

# Deliberately not given a line here. The first is refused outright; the others
# are read with a default, and left unlisted so that setting one is a deliberate
# act rather than an edit of a line already in front of you.
#
#   BROKER_LISTEN         127.0.0.1:8080, and the only sensible value: the broker
#                         speaks plain HTTP behind Caddy, which shares its network
#                         namespace, so a non-loopback bind serves the API in the
#                         clear on every host interface. `make up` refuses one.
#                         Must equal `listen` in configs/broker.toml.
#   BROKER_UID/_GID       10001/10002, a contract between four places rather than
#                         a preference -- compose.yaml's `user:` directives,
#                         `kbsetup directory`'s chgrp, and issuerd's
#                         `broker_uid` / `socket_gid`, commented out at these
#                         defaults in configs/issuerd.toml. Change both files
#                         together -- remove the `#` in issuerd.toml too -- or
#                         issuerd refuses the peer and no ticket is issued. Worth
#                         doing only for a gid collision on a production host.
#                         deploy/README.md @ Secrets.


# === 4. DEVELOPMENT BENCH ONLY ===============================================
#
# Inert in production. The demo users, the mock IdP's tenant id and the example
# file server's name and address are fixtures rather than decisions -- identical
# on every bench -- so they live in deploy/bench.env, which is tracked. Compose
# reads that file first and this one second, so a line here still overrides one
# there.
#
# The second group below cannot be deleted: compose.yaml is the macOS bench shape
# and interpolates those with no default, so an empty one fails
# `docker compose up`. They go with the host-networking shape.

# --- Delete these in production. compose.yaml reads none of them. ---

# The example-realm gate, off. `make up` otherwise refuses to provision while
# section 1 still names the documented example realm, and `kbsetup realm` in the
# container refuses the same thing against the config set. Keep it commented out
# anywhere but a bench, so `KB_ALLOW_EXAMPLE_REALM=1 make up` still works from
# the environment. Any non-empty value means yes. deploy/README.md @ The
# example-realm gate.
#KB_ALLOW_EXAMPLE_REALM=1

# The address the Windows VM reaches this host on. Read by no service and
# commented out for that reason -- it documents what your LAN resolver must
# answer: kerbridge.example.site with it, plus _kerberos._udp/_tcp SRV pointing
# at that name. It must not answer AAAA: a dual-stack answer against an
# IPv4-only Samba bind stalls the client.
#BENCH_HOST_IP=192.168.64.1

# --- Required while compose.yaml is the bench shape. Do not delete yet. ---

# The Compose bridge and the DC's static address on it. Static because the
# container resolves its own name from an /etc/hosts entry Compose writes at
# creation time, its read-only root filesystem leaving it unable to write one.
# Production uses host networking, where none of this exists.
KERBRIDGE_SUBNET=172.28.0.0/24
REALM_IPV4=172.28.0.10
